---
import T from './T.astro';
import Section from './Section.astro';
import { skills, ui } from '../content/cv';
---
<Section id="skills" num="05" title={ui.nav.skills}>
  <div class="skills-grid">
    {skills.map((g) => (
      <div class="skill-group">
        <h3><T s={g.name} /></h3>
        <ul>{g.items.map((i) => <li>{typeof i === 'string' ? i : <T s={i} />}</li>)}</ul>
      </div>
    ))}
  </div>
</Section>
