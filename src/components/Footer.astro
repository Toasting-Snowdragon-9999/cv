---
import T from './T.astro';
import { person, ui, lastUpdated } from '../content/cv';
const d = new Date(lastUpdated);
const monthEn = d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const monthDa = d.toLocaleDateString('da-DK', { month: 'long', year: 'numeric' });
const icon = {
  linkedin: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.5 8.5H3.6V21h2.9V8.5zM5 3.5a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4zM21 21h-2.9v-6.1c0-1.5-.03-3.3-2-3.3s-2.3 1.6-2.3 3.2V21H11V8.5h2.8v1.7h.04c.4-.7 1.3-1.5 2.8-1.5 3 0 3.5 2 3.5 4.5V21z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>',
  github: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84c.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>',
};
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <div class="footer-name">{person.name}</div>
        <div class="footer-sub"><T s={ui.degreeLine} /></div>
        <div class="footer-sub"><T s={person.city} /></div>
      </div>
      <div class="footer-icons">
        {person.linkedin && <a href={person.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" set:html={icon.linkedin} />}
        <a href={person.github} target="_blank" rel="noopener" aria-label="GitHub" set:html={icon.github} />
        <a href={`mailto:${person.email}`} aria-label="Email" set:html={icon.mail} />
        <a href={person.phoneHref} aria-label="Phone" set:html={icon.phone} />
      </div>
    </div>
    <div class="footer-contact">
      <a href={`mailto:${person.email}`}>{person.email}</a>
      <span class="dot">·</span>
      <a href={person.phoneHref}>{person.phone}</a>
      {person.linkedin && (
        <>
          <span class="dot">·</span>
          <a href={person.linkedin} target="_blank" rel="noopener">{person.linkedinLabel}</a>
        </>
      )}
    </div>
    <div class="footer-copy">
      © {d.getFullYear()} {person.name}. <span class="en">{ui.updated.en} {monthEn}.</span><span class="da">{ui.updated.da} {monthDa}.</span>
    </div>
  </div>
</footer>
