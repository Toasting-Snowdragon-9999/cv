---
import T from './T.astro';
import type { L } from '../content/cv';
interface Props { id: string; num: string; title: L }
const { id, num, title } = Astro.props;
---
<section class="section" id={id}>
  <div class="container">
    <div class="section-head">
      <span class="section-num">{num}</span>
      <h2 class="section-title"><T s={title} /></h2>
    </div>
    <slot />
  </div>
</section>
