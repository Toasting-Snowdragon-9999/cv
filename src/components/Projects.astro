---
import T from './T.astro';
import Section from './Section.astro';
import { projects, ui } from '../content/cv';
import { withBase } from '../lib/base';
const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---
<Section id="projects" num="04" title={ui.nav.projects}>
  <div class="projects-grid">
    {featured.map((p) => (
      <article class="card featured" id={`project-${p.id}`}>
        <div class="media">
          {p.video ? (
            <video autoplay muted loop playsinline preload="metadata" poster={withBase(p.image ?? '/projects/quadruped-poster.jpg')} aria-label={p.imageAlt?.en}>
              <source src={withBase(p.video)} type="video/mp4" />
            </video>
          ) : p.image ? (
            <img src={withBase(p.image)} alt={p.imageAlt?.en ?? ''} loading="lazy" />
          ) : null}
        </div>
        <div class="body">
          <div class="card-kicker"><T s={p.context} /></div>
          <h3><T s={p.title} /></h3>
          <p><T s={p.summary} /></p>
          {p.details && <ul class="bullets">{p.details.map((d) => <li><T s={d} /></li>)}</ul>}
          <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
          {p.repo && (
            <div class="card-links">
              <a href={p.repo} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
                <T s={ui.viewRepo} />
              </a>
            </div>
          )}
        </div>
      </article>
    ))}
    {others.map((p) => (
      <article class="card" id={`project-${p.id}`}>
        <div class="card-kicker"><T s={p.context} /></div>
        <h3><T s={p.title} /></h3>
        {p.todo ? <p class="pending"><T s={ui.textPending} /></p> : <p><T s={p.summary} /></p>}
        {p.details && <ul class="bullets">{p.details.map((d) => <li><T s={d} /></li>)}</ul>}
        <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
        {p.repo && (
          <div class="card-links">
            <a href={p.repo} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
              <T s={ui.viewRepo} />
            </a>
          </div>
        )}
      </article>
    ))}
  </div>
</Section>
